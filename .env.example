# Copie este arquivo para .env e personalize os valores (NUNCA envie .env ao GitHub).
COMPOSE_PROJECT_NAME=voaaguia-local
HOST_BIND_IP=127.0.0.1
HOST_PORT=8080
MONGO_DATABASE=voaaguia_sprint2
# Obrigatorio: pelo menos 32 bytes, preferencialmente um valor aleatorio.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_DE_PELO_MENOS_32_BYTES
# true apenas para demonstracao local; nunca habilitar em producao publica.
SEED_ENABLED=false
# Obrigatorio quando SEED_ENABLED=true (12 ou mais caracteres).
SEED_PASSWORD=
# Opcional: recursos de IA so funcionam com chave valida.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
